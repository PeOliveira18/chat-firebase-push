# Variáveis da API. Valores reais SOMENTE nas variáveis secretas do Render (nunca no GitHub).
PORT=3000
FIREBASE_PROJECT_ID=seu-project-id
FIREBASE_CLIENT_EMAIL=email-da-conta-de-servico@seu-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=CONFIGURAR_APENAS_NA_HOSPEDAGEM
FIREBASE_DATABASE_URL=https://seu-project-id-default-rtdb.firebaseio.com
# Opcional: token de acesso do Expo, se "Enhanced Security for Push Notifications" estiver ativo
EXPO_ACCESS_TOKEN=
# Cloudinary (fotos de perfil e de grupo) — plano gratuito, sem cartão
CLOUDINARY_CLOUD_NAME=grp8nkfh
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=CONFIGURAR_APENAS_NA_HOSPEDAGEM
