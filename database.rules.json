{
  "rules": {
    "messages": {
      "$conversationId": {
        ".read": "auth != null && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid) || root.child('groupMembers').child($conversationId).child(auth.uid).val() === true)",
        ".indexOn": ["createdAt"],
        "$messageId": {
          ".write": "auth != null && !data.exists() && newData.exists() && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid) || root.child('groupMembers').child($conversationId).child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['conversationType', 'senderId', 'text', 'target', 'createdAt'])",
          "conversationType": {
            ".validate": "(newData.val() === 'direct' && $conversationId.contains('_')) || (newData.val() === 'group' && !$conversationId.contains('_'))"
          },
          "senderId": {
            ".validate": "newData.val() === auth.uid"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "target": {
            ".validate": "newData.hasChildren(['type'])",
            "type": {
              ".validate": "newData.val() === 'conversation' || (newData.val() === 'member' && !$conversationId.contains('_'))"
            },
            "memberId": {
              ".validate": "newData.isString() && newData.parent().child('type').val() === 'member' && root.child('groupMembers').child($conversationId).child(newData.val()).val() === true"
            },
            "$other": {
              ".validate": false
            }
          },
          "mentionedUserIds": {
            "$index": {
              ".validate": "newData.isString() && root.child('groupMembers').child($conversationId).child(newData.val()).val() === true"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "groupMembers": {
      "$groupId": {
        ".read": "auth != null && data.child(auth.uid).val() === true",
        ".write": false
      }
    }
  }
}
